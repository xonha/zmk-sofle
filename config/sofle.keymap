#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&led_strip { chain-length = <30>; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        crtl_shift {
            bindings = <&kp LC(LEFT_SHIFT)>;
            key-positions = <37 52>;
        };

        left_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <27 28>;
        };

        right_shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main {
            display-name = "main";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp SQT     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                      &kp NUMBER_6  &kp NUMBER_7   &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp MINUS
&kp TAB     &kp Q         &kp W         &kp E         &kp R         &kp T                                             &kp Y         &kp U          &kp I         &kp O         &kp P          &trans
&kp ESC     &kp A         &kp S         &kp D         &kp F         &kp G                                             &kp H         &kp J          &kp K         &kp L         &kp SEMICOLON  &trans
&kp LSHIFT  &kp Z         &kp X         &kp C         &kp V         &kp B         &trans          &trans              &kp N         &kp M          &kp COMMA     &kp DOT       &kp SLASH      &kp RSHIFT
                          &trans        &trans        &kp LCTRL     &lt 1 SPACE   &kp LEFT_WIN    &mt LEFT_ALT ENTER  &lt 2 DELETE  &kp BACKSPACE  &trans        &trans
            >;
        };

        upper {
            display-name = "upper";
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                       &trans  &trans                 &trans                 &trans                &trans            &trans
&trans  &kp ASTERISK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS                     &none   &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)      &kp LS(LEFT_BRACKET)  &kp LEFT_BRACKET  &trans
&trans  &kp COMMA     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DOT                      &none   &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &kp LS(APOSTROPHE)    &kp APOSTROPHE    &trans
&trans  &kp RA(Q)     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp MINUS  &trans    &trans  &none   &kp RIGHT_BRACKET      &kp BACKSLASH          &kp GRAVE             &kp LS(GRAVE)     &trans
                      &trans        &trans        &kp NUMBER_0  &trans     &trans    &trans  &mo 3   &trans                 &trans                 &trans
            >;
        };

        lower {
            display-name = "lower";
            bindings = <
&trans  &trans                &trans           &trans     &trans        &trans                                      &trans    &trans         &trans       &trans     &trans             &trans
&trans  &kp RA(Q)             &kp RA(W)        &kp PLUS   &kp ASTERISK  &kp LS(NON_US_BACKSLASH)                    &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &kp C_VOLUME_UP    &trans
&trans  &kp NON_US_BACKSLASH  &kp UNDERSCORE   &kp MINUS  &kp EQUAL     &kp AMPERSAND                               &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &kp C_VOLUME_DOWN  &trans
&trans  &kp AT_SIGN           &kp EXCLAMATION  &kp HASH   &kp DOLLAR    &kp PERCENT               &trans    &trans  &kp F13   &kp F14        &kp F15      &kp F16    &kp CAPS           &trans
                              &trans           &trans     &trans        &mo 3                     &trans    &trans  &trans    &trans         &trans       &trans
            >;
        };

        extra {
            display-name = "extra";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans        &trans        &trans        &trans        &trans      &trans
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12                    &trans        &trans        &trans        &trans        &trans      &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11                    &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans    &trans  &trans        &trans        &trans        &trans        &trans      &trans
                &trans  &trans  &trans  &trans   &trans    &trans  &trans        &trans        &trans        &trans
            >;
        };
    };
};
